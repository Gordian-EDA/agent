 "texts": [
  {
   "text": "LOGIC AND P-GATE DRIVE",
   "at": [
    33.25,
    47.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "NPNs pull P-channel gates low; 100k resistors default off.",
   "at": [
    33.25,
    147.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "H-BRIDGE POWER STAGE",
   "at": [
    153.05,
    47.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "IN_A drives Q1/Q4; IN_B drives Q2/Q3. Never assert both.",
   "at": [
    153.05,
    138.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "POWER INPUT",
   "at": [
    33.25,
    158.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Keep bulk capacitor close to bridge supply entry.",
   "at": [
    33.25,
    184.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "NOTES",
   "at": [
    116,
    159
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Apply only one diagonal input high at a time; add firmware\ndead-time.",
   "at": [
    116,
    164.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Logic inputs are 3.3 V; bridge power is nominally 12 V.",
   "at": [
    116,
    169.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Use MOSFETs rated for motor stall current and at least 25 V\nVDS.",
   "at": [
    116,
    172.5
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Flyback diodes are external Schottky clamps around each\nswitch node.",
