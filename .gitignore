/target

# Local secrets — AWS Bedrock credentials, never commit
.env
.env.*
!.env.example

# Git worktrees (superpowers)
/.worktrees/

# Gordian project files
design.kicad_sch
design.kicad_pcb
design.kicad_prl
design.kicad_pro
~*.lck
/.history
fab

# ...but the placement-snapshot regression baselines ARE tracked (they ARE the gate),
# and so are the quality cases' input schematics — a case is not reproducible without one.
!crates/sch-floorplan/tests/snapshots/*.kicad_sch
!quality/cases/*/input/design.kicad_sch

# Quality run artifacts (renders, reports, the working project copy).
/quality/runs/

docs/validation/*.png

# Python bytecode cache for the tools/ scripts
tools/__pycache__/
tools/vendor/freerouting.jar

# Freerouting writes its run log here (CWD/logs/)
logs/
freerouting.json
tools/vendor/freerouting-2.2.4.jar
/target-slow
/target-rel

# Human-look reference renders are regenerated from the KiCAD demos by quality/run.py
quality/references/
