  {
   "text": "POWER",
   "at": [
    69.0,
    76.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "USB input, protection and dual regulated rails.",
   "at": [
    69.0,
    169.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "MCU CLOCK AND RESET",
   "at": [
    241.0,
    75.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "16 MHz clock, reset pull-up and user reset switch.",
   "at": [
    241.0,
    173.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "USB SERIAL",
   "at": [
    342.1,
    76.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "CH340C USB-UART bridge with isolated internal 3.3 V\ndecoupling.",
   "at": [
    342.1,
    173.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "HEADERS AND INDICATORS",
   "at": [
    69.95,
    180.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "All ATmega digital and analog I/O is brought to headers.",
   "at": [
    69.95,
    250.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "NOTES",
   "at": [
    240,
    183
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "USB-C CC pins use 5.1k sink resistors for device mode.",
   "at": [
    240,
    188.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "DTR edge through C1 provides CH340C auto-reset.",
   "at": [
    240,
    191.5
   ],
   "size": 1.27,
   "bold": false
  }
