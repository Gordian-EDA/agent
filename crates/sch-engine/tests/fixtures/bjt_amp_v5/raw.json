 "texts": [
  {
   "text": "INPUT AND BIAS",
   "at": [
    32.2,
    30.4
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "R1/R2 establish the quiescent base voltage; C1 blocks DC.",
   "at": [
    32.2,
    98.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "AMPLIFIER OUTPUT",
   "at": [
    102.9,
    31.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Collector load, transistor, emitter network, and output\ncoupling.",
   "at": [
    102.9,
    79.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "NOTES",
   "at": [
    32,
    113
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "V9 is the positive terminal of the 9 V battery supply.",
   "at": [
    32,
    118.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Q1 operates as a voltage amplifier with approximately 1 kOhm\nemitter degeneration.",
   "at": [
    32,
    121.5
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "C3 bypasses AC emitter feedback for increased midband gain.",
   "at": [
    32,
    126.5
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "C1 and C2 provide DC isolation at the input and output.",
   "at": [
    32,
    130.0
   ],
   "size": 1.27,
   "bold": false
  }
 ],
