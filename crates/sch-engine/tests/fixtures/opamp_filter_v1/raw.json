 "nc": [],
 "texts": [
  {
   "text": "POWER / VIRTUAL GROUND",
   "at": [
    61.3,
    41.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "R1/R2 create the 4.5 V reference; C1 provides low-impedance\nAC ground.",
   "at": [
    61.3,
    140.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "INPUT / 1 kHz LOW-PASS",
   "at": [
    139.35,
    40.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Equal 15.8 kOhm and 10 nF values set approximately 1 kHz\ncutoff.",
   "at": [
    139.35,
    94.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "GAIN 10 / OUTPUT",
   "at": [
    62.1,
    151.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "R7/R6 set 1 + 90k/10k = 10; C5 blocks the DC bias at the\noutput jack.",
   "at": [
    62.1,
    189.0
   ],
   "size": 1.27,
   "bold": false
  }
 ],
 "rects": [],
 "paper": "A3",
 "title": "1 kHz Sallen-Key Low-Pass and Gain 10",
 "rev": "1.0",
 "date": "2026-09-02",
 "company": "OpenAI Engineering",
 "comments": [
  "Single 9 V battery supply with buffered virtual ground",
  "Unity-gain Sallen-Key filter followed by non-inverting gain of 10",
  "Stereo TRS jacks used as mono input and output"
 ]
