# auto-pcb model provider configuration. Copy to .env and fill in.
# The engines (placement/routing/layout) need NO keys — only the LLM agent loop does.

# --- Option A: OpenAI-compatible gateway ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- Option B: AWS Bedrock ---
# AGENT_PROVIDER=bedrock
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# Optional overrides
# AGENT_MODEL=
