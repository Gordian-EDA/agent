 "texts": [
  {
   "text": "POWER INPUT",
   "at": [
    41.25,
    52.0
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Keep bulk capacitor close to bridge supply entry.",
   "at": [
    41.25,
    107.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "LEFT HALF-BRIDGE",
   "at": [
    133.05,
    51.15
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "IN_A turns on Q1 and the opposite low-side Q4.",
   "at": [
    133.05,
    113.85
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "RIGHT HALF-BRIDGE",
   "at": [
    254.1,
    51.15
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "IN_B turns on Q2 and the opposite low-side Q3.",
   "at": [
    254.1,
    113.85
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "LOGIC AND GATE DRIVE",
   "at": [
    41.2,
    124.1
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Diagonal drive: IN_A = Q1/Q4, IN_B = Q2/Q3.",
   "at": [
    41.2,
    275.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "NOTES",
   "at": [
    376,
    51
   ],
   "size": 2.5,
   "bold": true
  },
  {
   "text": "Apply only one diagonal input high at a time; add firmware\ndead-time.",
   "at": [
    376,
    56.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Logic inputs are 3.3 V; bridge power is nominally 12 V.",
   "at": [
    376,
    61.0
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Use MOSFETs rated for motor stall current and at least 25 V\nVDS.",
   "at": [
    376,
    64.5
   ],
   "size": 1.27,
   "bold": false
  },
  {
   "text": "Flyback diodes are external Schottky clamps around each\nswitch node.",
   "at": [
    376,
    69.5
   ],
   "size": 1.27,
   "bold": false
  }
