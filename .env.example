# Gordian LLM provider — bring your own key (BYOK). Copy to .env and fill in.
# The engines (placement/routing/layout) need NO keys — only the agent loop does.
#
# Always set AGENT_MODEL: genai picks the provider from the model id (or a
# `namespace::model` prefix) and reads that provider's standard key itself.

# --- Any genai-supported provider, directly ---
#   ANTHROPIC_API_KEY=...     AGENT_MODEL=claude-sonnet-4-6
#   OPENAI_API_KEY=...        AGENT_MODEL=gpt-4o
#   GEMINI_API_KEY=...        AGENT_MODEL=gemini-2.0-flash
#   BEDROCK_API_KEY=...       AGENT_MODEL=bedrock_api::anthropic.claude-sonnet-4-5-20250929-v1:0   (AWS_REGION optional)
#   OPEN_ROUTER_API_KEY=...   AGENT_MODEL=open_router::anthropic/claude-sonnet-4-5

# --- A private OpenAI-compatible gateway / self-hosted endpoint ---
# genai's custom adapter: `genai_N::<model>` reads GENAI_N_ENDPOINT + GENAI_N_API_KEY.
#   GENAI_1_ENDPOINT=https://your-gateway/v1
#   GENAI_1_API_KEY=...
#   AGENT_MODEL=genai_1::anthropic/claude-sonnet-4-6
